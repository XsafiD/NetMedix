# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-in-production

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# Gunicorn Configuration (production)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# Database (future PostgreSQL support)
DATABASE_URL=sqlite:///database/history.db
# DATABASE_URL=postgresql://user:password@db:5432/netmedix

# Nginx Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443
